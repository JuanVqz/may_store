<%# locals: (order:, items:) %>

<div class="max-w-md mx-auto p-4 space-y-4 mt-12"
     data-controller="print"
     data-print-messages-value="<%= t("receipt.errors").to_json %>"
     data-print-preview-value="<%= thermal_preview? %>">
  <%# One card for the whole receipt: heading, order meta, items and total. Split
      across two cards it read as two unrelated panels. %>
  <%= render "components/card" do %>
    <%# card/title takes `text:`; it renders `text || content` and never yields, so
        a block passed to it is silently dropped and the heading comes out empty. %>
    <%= render "components/card/header" do %>
      <%= render "components/card/title", text: t("order.closed_title") %>
    <% end %>

    <%= render "components/card/content" do %>
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm mb-4">
        <dt class="text-muted-foreground"><%= t("bill.order") %>:</dt>
        <dd><%= order.code %></dd>
        <dt class="text-muted-foreground"><%= t("bill.table") %>:</dt>
        <dd><%= order.spot.name %></dd>
      </dl>

      <p class="text-sm text-muted-foreground mb-4">
        <%= t("order.table_now_available", name: order.spot.name) %>
      </p>

      <%# Item text sits in a <div>, not a <span>: line_items/components emits
          <div> elements, and block content inside an inline element is invalid.
          herb lint cannot catch it because it cannot see through `render`. %>
      <ul class="space-y-2 text-sm border-t border-border pt-3">
        <% items.each_with_index do |item, idx| %>
          <li class="flex justify-between gap-4 <%= "line-through text-muted-foreground" if item.cancelled? %>">
            <div class="flex-1">
              <div class="font-medium">#<%= idx + 1 %>&nbsp;&nbsp;<%= item.product.name %></div>
              <%= render "line_items/components", item: item %>
              <%= render "line_items/cancellation_reason", item: item %>
            </div>
            <div class="whitespace-nowrap">
              <% if item.cancelled? %>
                <%= t("bill.cancelled") %>
              <% else %>
                <%= item.formatted_total_price %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <div class="border-t border-border mt-4 pt-3 flex justify-between font-bold">
        <span><%= t("bill.total") %></span>
        <span><%= order.formatted_total %></span>
      </div>
    <% end %>
  <% end %>

  <div class="grid grid-cols-2 gap-2">
    <%= tag.button t("bill.print"), type: "button",
          class: "text-center",
          data: { component: "button", variant: "outline", size: "lg",
                  action: "print#receipt", print_url_param: order_receipt_path(order) } %>
    <%= link_to t("order.back_to_tables"), tables_path,
          class: "text-center",
          data: { component: "button", variant: "primary", size: "lg" } %>
  </div>
</div>
