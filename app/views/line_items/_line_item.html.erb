<%# locals: (item:, order:, highlight: false) %>

<div id="line_item_<%= item.id %>" class="flex flex-wrap gap-2 p-4 border-b border-border last:border-b-0" data-status="<%= item.status %>"
  data-controller="<%= "highlight" if highlight %>">
  <div class="flex-1 min-w-0">
    <div class="font-semibold text-sm">
      <%= item.product.name %>
      <span class="<%= status_badge_classes(item.status) %>"><%= item.status_label %></span>
    </div>
    <%= render "line_items/components", item: item %>
    <% if item.special_notes.present? %>
      <div class="text-sm text-muted-foreground"><em><%= item.special_notes %></em></div>
    <% end %>
  </div>
  <div class="flex w-full md:w-auto items-center justify-between md:flex-col md:items-end gap-1">
    <span class="font-bold text-primary"><%= item.formatted_total_price %></span>
    <%# Wider than gap-1 because a transition button and a destructive one sit side
        by side here. The kitchen cards pin them to opposite edges for the same
        reason: a mis-tap must not hit the other one, and Marcar Entregado has no
        confirm dialog and no undo, since delivering makes the item uncancellable. %>
    <div class="flex gap-3">
      <% if item.ordering? %>
        <%= button_to t("delete"),
              order_line_item_path(order, item),
              method: :delete,
              data: { component: "button", variant: "destructive", size: "sm" } %>
      <% end %>
      <% if item.cooking? %>
        <%= button_to t("kitchen.ready"),
              order_line_item_readiness_path(order, item),
              data: { component: "button", variant: "primary", size: "sm" } %>
        <%= render "line_items/cancel_button", item: item, size: "sm" %>
      <% end %>
      <%# A ready item can still be cancelled: a customer who changes their mind
          the moment the drink reaches the pass should not need the kitchen to do
          it for them. The kitchen screen has always offered this, and the model
          has always allowed it; only this screen was missing it. Delivered items
          stay uncancellable, since the food is on the table. %>
      <% if item.ready? %>
        <%= button_to t("line_item.mark_delivered"),
              order_line_item_delivery_path(order, item),
              data: { component: "button", variant: "primary", size: "sm" } %>
        <%= render "line_items/cancel_button", item: item, size: "sm" %>
      <% end %>
    </div>
  </div>
</div>
