<%# locals: (item:) %>

<%# Shown only once an item is cancelled, and only to correct what cancelling
    already recorded. Cancelling itself stays one tap: a waiter standing at a
    table would answer a required dropdown with whatever sits at the top of it
    every time, which is worse than no data because it would look deliberate. %>
<% if item.cancelled? %>
  <%= form_with model: item, url: order_line_item_path(item.order, item), method: :patch,
        data: { controller: "auto-submit" } do |f| %>
    <label class="text-xs text-muted-foreground" for="<%= dom_id(item, :cancellation_reason) %>">
      <%= t("line_item.cancellation_reason") %>
    </label>
    <%= f.select :cancellation_reason,
          LineItem.cancellation_reasons.keys.map { |reason| [t("cancellation_reasons.#{reason}"), reason] },
          { include_blank: false },
          id: dom_id(item, :cancellation_reason),
          class: "text-xs py-1 px-2 rounded-md border border-border bg-background",
          data: { action: "change->auto-submit#submit" } %>
  <% end %>
<% end %>
