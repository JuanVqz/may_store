<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from "store_#{Current.store.id}_kitchen" %>

<% content_for :title, t("kitchen.title") %>

<div data-view="kitchen">
  <div class="flex items-center justify-between mb-4">
    <span class="text-sm text-muted-foreground"><%= t("kitchen.ordered_by") %>: <%= t("kitchen.oldest_first") %></span>
    <span class="text-sm text-muted-foreground" id="kitchen-queue-count"><%= t("kitchen.queue_count", count: @line_items.size) %></span>
  </div>

  <div id="kitchen-queue" class="space-y-6">
    <% if @line_items.empty? %>
      <%= render "components/empty" do %>
        <%= render "components/empty/header" do %>
          <%= render "components/empty/title", text: t("kitchen.no_items") %>
        <% end %>
      <% end %>
    <% end %>
    <% @line_items.group_by(&:order).each do |order, items| %>
      <% spot = order.spot %>
      <% spot_label = spot.takeout? ? t("spot_types.takeout") : spot.name %>
      <%# The queue is sorted oldest first, so the group's first item is its oldest. %>
      <% oldest_item = items.first %>
      <%# The kitchen waits from the moment the order was confirmed, not from when
          the waiter first tapped the product: items are created as `ordering` and
          only flip to `cooking` at confirm!. Items added to an already-cooking
          order are newer than cooking_at, so max reads right either way. %>
      <% waiting_since = [oldest_item.created_at, order.cooking_at].compact.max %>
      <% by_station = items.group_by { |i| i.product.category.station } %>
      <% stations = Category.stations.keys.select { |station| by_station[station].present? } %>
      <div class="border-2 border-border rounded-lg overflow-hidden"
           data-kitchen-order="<%= order.id %>"
           data-controller="print"
           data-print-messages-value="<%= t("receipt.errors").to_json %>"
           data-print-preview-value="<%= thermal_preview? %>">
        <%# Stacks on phones so the order meta never squeezes into a narrow column. %>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4 bg-muted px-4 py-3 border-b border-border kitchen-order-header">
          <%# Everything shared by the order's items lives here, once. %>
          <span class="flex flex-wrap items-baseline gap-x-2">
            <strong class="text-lg"><%= spot_label %></strong>
            <span class="text-sm text-muted-foreground">
              <%= order.code %> &middot;
              <%= l(order.opened_at || order.created_at, format: :time_only) %> &middot;
              <%= order.user.name %>
            </span>
          </span>
          <span class="flex items-baseline justify-between gap-4 sm:justify-end">
            <%# Ticks client-side: broadcasts are the only re-render, and a quiet %>
            <%# kitchen would otherwise leave this frozen at its rendered value. %>
            <span class="kitchen-order-elapsed text-sm font-semibold text-muted-foreground whitespace-nowrap"
                  data-controller="elapsed"
                  data-elapsed-start-value="<%= waiting_since.iso8601 %>"
                  data-elapsed-template-value="<%= t("kitchen.waiting", minutes: "%{minutes}") %>">
              <%= t("kitchen.waiting", minutes: ((Time.current - waiting_since) / 60).floor) %>
            </span>
            <%= tag.button t("print"), type: "button",
                  class: "kitchen-print-btn text-sm font-normal underline underline-offset-2 cursor-pointer",
                  data: { action: "print#ticket", print_url_param: order_kitchen_ticket_path(order) } %>
          </span>
        </div>
        <%# One column per prep area on tablet and up; stacked sections on phones.
            print:grid-cols-1 because `md:` is a viewport query that also matches the
            print media width (A4 is ~794px), and two columns inside the 72mm thermal
            ticket wraps every product name. %>
        <div class="grid gap-3 p-3 <%= "md:grid-cols-2 print:grid-cols-1" if stations.size > 1 %>">
          <% stations.each do |station| %>
            <section class="space-y-3" data-kitchen-station="<%= station %>">
              <h3 class="text-xs font-bold uppercase tracking-wide text-muted-foreground">
                <%= t("stations.#{station}") %>
              </h3>
              <% by_station[station].each do |item| %>
                <%= render "kitchen/line_item_card", item: item %>
              <% end %>
            </section>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
