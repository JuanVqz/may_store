<%# locals: (item:) %>

<%# Kitchen-only rendering of an item's customizations: bigger type than the %>
<%# waiter-facing "line_items/components". Every ingredient is listed so a new %>
<%# cook knows the full recipe; only the modified portions are bolded. %>

<% ingredients = item.line_item_components.select(&:ingredient?) %>
<% extras = item.line_item_components.select(&:extra?) %>

<% if ingredients.any? %>
  <ul class="mt-2 space-y-1">
    <% ingredients.each do |c| %>
      <% modified = c.portion.to_f != 1.0 %>
      <li class="text-base <%= modified ? "text-foreground" : "text-muted-foreground" %>">
        <%= c.component.name %>:
        <% if modified %>
          <strong class="font-bold"><%= c.portion_label %></strong>
        <% else %>
          <%= c.portion_label %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if extras.any? %>
  <ul class="mt-2 space-y-1">
    <% extras.group_by(&:component_id).each_value do |group| %>
      <li class="text-base text-foreground">
        + <strong class="font-bold"><%= group.first.component.name %> x<%= group.size %></strong>
      </li>
    <% end %>
  </ul>
<% end %>

<% if item.special_notes.present? %>
  <div class="mt-3 rounded-md border-l-4 border-l-orange-500 bg-orange-50 px-3 py-2 text-base font-semibold text-orange-700">
    <%= item.special_notes %>
  </div>
<% end %>
