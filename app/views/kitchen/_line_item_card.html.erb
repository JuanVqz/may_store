<%# locals: (item:) %>

<%# The queue renders oldest first, so position carries the urgency; the only %>
<%# state worth a color here is "ready and waiting on a waiter". %>
<% border_class = item.ready? ? "border-l-4 border-l-green-500" : "" %>

<%# Order code, spot, time and waiter live on the order header above, not here. %>
<%= render "components/card", id: "line_item_card_#{item.id}", css_classes: "overflow-hidden #{border_class}" do %>
  <%= render "components/card/content" do %>
    <%# Wait time lives on the order header; only the per-item ready state here. %>
    <% if item.ready? %>
      <div class="text-sm font-semibold text-green-700 mb-1">
        <%= t("kitchen.waiting_for_waiter") %>
      </div>
    <% end %>

    <div class="font-bold text-2xl kitchen-product-name"><%= item.product.name.upcase %></div>

    <%= render "kitchen/item_details", item: item %>
  <% end %>

  <%= render "components/card/footer" do %>
    <%# Actions are pinned to opposite edges so a mis-tap cannot hit the other one.

        The queue selects items by their own status, so an item whose order was
        already paid still shows up here and still needs delivering. Cancel is the
        one action the model refuses there, and the shared partial leaves it out. %>
    <div class="flex items-center justify-between gap-8 w-full">
      <% if item.cooking? %>
        <%= button_to t("kitchen.ready"),
              ready_order_line_item_path(item.order, item),
              method: :patch,
              data: { component: "button", variant: "primary", size: "lg" } %>
        <%= render "line_items/cancel_button", item: item, size: "lg" %>
      <% elsif item.ready? %>
        <%= button_to t("line_item.mark_delivered"),
              deliver_order_line_item_path(item.order, item),
              method: :patch,
              data: { component: "button", variant: "primary", size: "lg" } %>
        <%= render "line_items/cancel_button", item: item, size: "lg" %>
      <% end %>
    </div>
  <% end %>
<% end %>
